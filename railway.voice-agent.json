{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter \"@toolboxjl/voice-agent...\" run build"
  },
  "deploy": {
    "startCommand": "node apps/voice-agent/dist/main.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
