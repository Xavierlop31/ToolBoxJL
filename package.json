{
  "name": "toolboxjl",
  "private": true,
  "version": "0.0.0",
  "description": "ToolBox JL — plataforma de gestión, alquiler, venta de herramientas y logística inteligente. Monorepo pnpm + Turborepo.",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "spec:lint": "spectral lint openapi.yaml --ruleset .spectral.yaml",
    "bdd:lint": "node scripts/validate-gherkin.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  }
}
