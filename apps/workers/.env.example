# apps/workers — variables de entorno
#
# MoraCalculatorJob (Sprint 5, RF-4.3) consume el MISMO Postgres que apps/api
# (Supabase) — no hay un schema Prisma propio acá, ver comentario de
# cabecera de src/main.ts.
#
# Ej.: postgresql://postgres:<password>@db.xxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=

# RouteSchedulerJob / Agente 1 (Sprint 7, Issue #22, HU-8.1, TRD §4.1) —
# ver src/route-scheduler-job.ts y src/agente-1/*. A diferencia de
# MoraCalculatorJob, este job NO usa Prisma/DATABASE_URL: llama a apps/api
# por HTTP real.

# Credencial de la API de Anthropic (Claude). Sin esta, RouteSchedulerJob
# falla al arrancar con un error explícito (no hay fallback silencioso ni
# modo mock) — ver src/agente-1/config.ts. Para tests/BDD no hace falta: se
# usa un mock de AnthropicMessagesClient, no la key real.
ANTHROPIC_API_KEY=

# Modelo de Claude a usar. Default (si no se define): claude-haiku-4-5 —
# decisión explícita del Arquitecto para este sprint, para conservar el
# saldo de USD 7,5 de la cuenta de Anthropic del ciclo de implementación
# (CLAUDE.md §8) mientras se itera. Configurable para subir de modelo sin
# tocar código si la calidad del ruteo lo justifica más adelante.
ANTHROPIC_MODEL=claude-haiku-4-5

# URL base de la instancia de apps/api contra la que este job llama
# GET /logistics/pending-orders, GET /fleet/vehicles y
# POST /logistics/assign-routes. Sin fallback entre entornos (es config de
# infraestructura, no una regla de negocio) — ej. en desarrollo local,
# http://localhost:3000; en Railway, la URL pública del deploy de apps/api.
API_BASE_URL=

# Credenciales del usuario de servicio de Supabase Auth
# (agente-ruteo@toolboxjl.internal, app_metadata.rol = "agente-1" — decisión
# ya tomada con el Arquitecto) que este job usa para loguearse vía
# POST {SUPABASE_URL}/auth/v1/token?grant_type=password y obtener el JWT que
# manda como Bearer token a apps/api. *** Es probable que esta cuenta NO
# exista todavía en Supabase Auth de este proyecto *** — si el login falla
# (401/400), es un bloqueo real a reportar al Tech Lead, no algo para
# resolver inventando credenciales — ver src/agente-1/auth-gateway.ts. Para
# tests/BDD no hace falta: se usa InMemoryAgente1AuthGateway.
AGENTE_1_SERVICE_EMAIL=
AGENTE_1_SERVICE_PASSWORD=

# SUPABASE_URL: mismo valor que ya usa apps/api (Project Settings > API >
# Project URL). SUPABASE_ANON_KEY: la "anon public" key del mismo proyecto —
# GoTrue la exige como header `apikey` incluso para login con
# email/password, no solo para operaciones anónimas.
SUPABASE_URL=
SUPABASE_ANON_KEY=
