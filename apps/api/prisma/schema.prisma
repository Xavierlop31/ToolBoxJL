// ToolBox JL — apps/api/prisma/schema.prisma
//
// Sprint 1 (Issues #1-#4, HU-1.1 a 1.4 — CatalogModule/InventoryModule):
// SOLO los 3 modelos de docs/DESIGN.md §4.1 que corresponden a esta Épica
// (TOOL_MODELS, TOOL_UNITS, TOOL_UNIT_STATUS_LOG). El resto del ER diagram
// (USERS, ORDERS, PAYMENTS, VEHICLES, SHIPMENTS, ROUTES,
// INSPECTION_CHECKLISTS, ...) llega en sprints posteriores, cada uno con su
// propia migración — no se modela acá a propósito.
//
// Nombres de campo: en español, alineados 1:1 con docs/DESIGN.md §4.1 y con
// los schemas ToolModel/ToolUnit/ToolUnitStatusLogEntry de openapi.yaml. Los
// nombres de propiedad del cliente Prisma son camelCase (idiomático); el
// `@map` fija el nombre real de columna en snake_case. El contrato de API
// (packages/shared-types, openapi.yaml) usa snake_case directamente — el
// mapeo entre ambos ocurre en las implementaciones de repositorio de
// apps/api/src/modules/catalog-inventory/infrastructure/prisma.
//
// IMPORTANTE — esta migración NO fue ejecutada contra una base real: este
// entorno de desarrollo no tiene una conexión a una instancia de Supabase
// (no hay DATABASE_URL de una base viva disponible acá). El
// schema.prisma y la migración SQL de
// prisma/migrations/20260824000000_init_catalog_inventory/migration.sql
// fueron escritos a mano, siguiendo el mismo formato que genera
// `prisma migrate dev`, pero NUNCA corrieron contra un Postgres real.
// Es responsabilidad de quien tenga las credenciales de Supabase (Tech
// Lead / DevOps) aplicar `prisma migrate deploy` (o revisar y ejecutar el
// SQL a mano) contra el proyecto real antes de que CatalogModule/
// InventoryModule puedan funcionar en un entorno desplegado.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Estados de la hoja de vida de una unidad física (RF-1.3). Los valores del
/// contrato de API (openapi.yaml, packages/shared-types EstadoUnidad) tienen
/// espacios ("En Mantenimiento", "Dado de Baja"); acá se mapean a
/// identificadores válidos de enum de Postgres vía @map.
enum EstadoUnidad {
  Nuevo
  Excelente
  Operativo
  EnMantenimiento @map("En Mantenimiento")
  DadoDeBaja      @map("Dado de Baja")

  @@map("estado_unidad")
}

enum TipoOrden {
  alquiler
  venta

  @@map("tipo_orden")
}

enum EstadoOrden {
  pendiente_pago @map("pendiente_pago")
  confirmada
  en_curso       @map("en_curso")
  devuelta
  cerrada
  cancelada

  @@map("estado_orden")
}

enum ModoRetorno {
  en_sede           @map("en_sede")
  recogida_domicilio @map("recogida_domicilio")

  @@map("modo_retorno")
}

/// Ficha técnica de un modelo de herramienta (SKU) — RF-1.1.
model ToolModel {
  id      String @id @default(uuid()) @db.Uuid
  nombre  String
  marca   String
  categoria String

  potenciaW Float? @map("potencia_w")
  pesoKg    Float? @map("peso_kg")
  volumenM3 Float? @map("volumen_m3")

  /// COP, entero. Único campo de tarifa obligatorio (ToolModelInput).
  tarifaDia      Int    @map("tarifa_dia")
  tarifaSemana   Int?   @map("tarifa_semana")
  costoCompra    Int?   @map("costo_compra")
  depositoPct    Float? @map("deposito_pct")
  interesMoraDia Float? @map("interes_mora_dia")
  manualPdfUrl   String? @map("manual_pdf_url")

  disponibleParaVenta Boolean @default(true) @map("disponible_para_venta")

  unidades ToolUnit[]

  @@map("tool_models")
}

/// Unidad física serializada de un modelo — RF-1.2. `id` es el mismo UUID
/// codificado en el QR físico impreso (el QR en sí no se persiste acá, se
/// genera on-demand — ver InventoryModule/infrastructure/qr).
model ToolUnit {
  id          String       @id @default(uuid()) @db.Uuid
  modeloId    String       @map("modelo_id") @db.Uuid
  numeroSerie String       @unique @map("numero_serie")
  estado      EstadoUnidad @default(Nuevo)
  fechaIngreso DateTime    @default(now()) @map("fecha_ingreso") @db.Date

  modelo    ToolModel           @relation(fields: [modeloId], references: [id])
  historial ToolUnitStatusLog[]
  orderItems OrderItem[]

  @@map("tool_units")
  @@index([modeloId])
}

/// Hoja de vida de una unidad — RF-1.3. Tabla append-only (sin UPDATE/DELETE
/// una vez insertada la entrada), igual que el patrón de
/// docs/DESIGN.md §4.2 para `tool_unit_status_log`/`inspection_checklists`.
model ToolUnitStatusLog {
  id             String        @id @default(uuid()) @db.Uuid
  unidadId       String        @map("unidad_id") @db.Uuid
  estadoAnterior EstadoUnidad? @map("estado_anterior")
  estadoNuevo    EstadoUnidad  @map("estado_nuevo")
  fotosUrls      String[]      @default([]) @map("fotos_urls")
  /// FK lógica a `public.users.id` (Supabase Auth / AuthModule, Sprint 0).
  /// No se declara como relación de Prisma porque `users` no forma parte de
  /// este schema (fuera de alcance de Sprint 1 — ver comentario de cabecera).
  autorId   String   @map("autor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  unidad ToolUnit @relation(fields: [unidadId], references: [id])

  @@map("tool_unit_status_log")
  @@index([unidadId])
}

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  clienteId        String      @map("cliente_id") @db.Uuid
  tipo             TipoOrden
  estado           EstadoOrden @default(pendiente_pago)
  fechaInicio      DateTime?   @map("fecha_inicio") @db.Date
  fechaFin         DateTime?   @map("fecha_fin") @db.Date
  returnMode       ModoRetorno @map("return_mode")
  direccionEntrega String      @map("direccion_entrega")
  zonaId           String      @map("zona_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at")

  items OrderItem[]

  @@map("orders")
  @@index([clienteId])
}

model OrderItem {
  id             String @id @default(uuid()) @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  unidadId       String @map("unidad_id") @db.Uuid
  tarifaAplicada Int    @map("tarifa_aplicada")

  order  Order    @relation(fields: [orderId], references: [id])
  unidad ToolUnit @relation(fields: [unidadId], references: [id])

  @@map("order_items")
  @@index([orderId])
  @@index([unidadId])
}
