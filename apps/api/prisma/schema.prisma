// ToolBox JL — apps/api/prisma/schema.prisma
//
// Sprint 1 (Issues #1-#4, HU-1.1 a 1.4 — CatalogModule/InventoryModule):
// SOLO los 3 modelos de docs/DESIGN.md §4.1 que corresponden a esta Épica
// (TOOL_MODELS, TOOL_UNITS, TOOL_UNIT_STATUS_LOG). El resto del ER diagram
// (USERS, ORDERS, PAYMENTS, VEHICLES, SHIPMENTS, ROUTES,
// INSPECTION_CHECKLISTS, ...) llega en sprints posteriores, cada uno con su
// propia migración — no se modela acá a propósito.
//
// Nombres de campo: en español, alineados 1:1 con docs/DESIGN.md §4.1 y con
// los schemas ToolModel/ToolUnit/ToolUnitStatusLogEntry de openapi.yaml. Los
// nombres de propiedad del cliente Prisma son camelCase (idiomático); el
// `@map` fija el nombre real de columna en snake_case. El contrato de API
// (packages/shared-types, openapi.yaml) usa snake_case directamente — el
// mapeo entre ambos ocurre en las implementaciones de repositorio de
// apps/api/src/modules/catalog-inventory/infrastructure/prisma.
//
// IMPORTANTE — esta migración NO fue ejecutada contra una base real: este
// entorno de desarrollo no tiene una conexión a una instancia de Supabase
// (no hay DATABASE_URL de una base viva disponible acá). El
// schema.prisma y la migración SQL de
// prisma/migrations/20260824000000_init_catalog_inventory/migration.sql
// fueron escritos a mano, siguiendo el mismo formato que genera
// `prisma migrate dev`, pero NUNCA corrieron contra un Postgres real.
// Es responsabilidad de quien tenga las credenciales de Supabase (Tech
// Lead / DevOps) aplicar `prisma migrate deploy` (o revisar y ejecutar el
// SQL a mano) contra el proyecto real antes de que CatalogModule/
// InventoryModule puedan funcionar en un entorno desplegado.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Estados de la hoja de vida de una unidad física (RF-1.3). Los valores del
/// contrato de API (openapi.yaml, packages/shared-types EstadoUnidad) tienen
/// espacios ("En Mantenimiento", "Dado de Baja"); acá se mapean a
/// identificadores válidos de enum de Postgres vía @map.
enum EstadoUnidad {
  Nuevo
  Excelente
  Operativo
  EnMantenimiento @map("En Mantenimiento")
  DadoDeBaja      @map("Dado de Baja")

  @@map("estado_unidad")
}

enum TipoOrden {
  alquiler
  venta

  @@map("tipo_orden")
}

enum EstadoOrden {
  pendiente_pago @map("pendiente_pago")
  confirmada
  en_curso       @map("en_curso")
  devuelta
  cerrada
  cancelada

  @@map("estado_orden")
}

enum ModoRetorno {
  en_sede           @map("en_sede")
  recogida_domicilio @map("recogida_domicilio")

  @@map("modo_retorno")
}

/// Ficha técnica de un modelo de herramienta (SKU) — RF-1.1.
model ToolModel {
  id      String @id @default(uuid()) @db.Uuid
  nombre  String
  marca   String
  categoria String

  potenciaW Float? @map("potencia_w")
  pesoKg    Float? @map("peso_kg")
  volumenM3 Float? @map("volumen_m3")

  /// COP, entero. Único campo de tarifa obligatorio (ToolModelInput).
  tarifaDia      Int    @map("tarifa_dia")
  tarifaSemana   Int?   @map("tarifa_semana")
  costoCompra    Int?   @map("costo_compra")
  depositoPct    Float? @map("deposito_pct")
  interesMoraDia Float? @map("interes_mora_dia")
  manualPdfUrl   String? @map("manual_pdf_url")
  precioVenta    Int?    @map("precio_venta")

  disponibleParaVenta Boolean @default(true) @map("disponible_para_venta")

  unidades  ToolUnit[]
  /// Sprint 9 — líneas de carrito que referencian este modelo (CartModule).
  cartItems CartItem[]

  @@map("tool_models")
}

/// Unidad física serializada de un modelo — RF-1.2. `id` es el mismo UUID
/// codificado en el QR físico impreso (el QR en sí no se persiste acá, se
/// genera on-demand — ver InventoryModule/infrastructure/qr).
///
/// `fechaAdquisicion`/`costoCompra`/`ubicacionBodega` (Sprint 14, HU-13.2):
/// nullable — unidades creadas antes de este campo no lo tienen, aunque
/// `POST /inventory/units` los exige a partir de este sprint (validación en
/// `CrearUnidadDto`, no acá en el schema).
model ToolUnit {
  id          String       @id @default(uuid()) @db.Uuid
  modeloId    String       @map("modelo_id") @db.Uuid
  numeroSerie String       @unique @map("numero_serie")
  estado      EstadoUnidad @default(Nuevo)
  fechaIngreso DateTime    @default(now()) @map("fecha_ingreso") @db.Date
  fechaAdquisicion DateTime? @map("fecha_adquisicion") @db.Date
  costoCompra      Int?      @map("costo_compra")
  ubicacionBodega  String?   @map("ubicacion_bodega")

  modelo    ToolModel           @relation(fields: [modeloId], references: [id])
  historial ToolUnitStatusLog[]
  orderItems OrderItem[]
  inspecciones InspectionChecklist[]

  @@map("tool_units")
  @@index([modeloId])
}

/// Tipo de orden de taller (Sprint 14, HU-13.3) — solo aplica cuando
/// `ToolUnitStatusLog.estadoNuevo = EnMantenimiento`.
enum TipoMantenimiento {
  Preventivo
  Correctivo

  @@map("tipo_mantenimiento")
}

/// Hoja de vida de una unidad — RF-1.3. Tabla append-only (sin UPDATE/DELETE
/// una vez insertada la entrada), igual que el patrón de
/// docs/DESIGN.md §4.2 para `tool_unit_status_log`/`inspection_checklists`.
///
/// Los 6 campos de mantenimiento (Sprint 14, HU-13.3) son opcionales:
/// `tipoMantenimiento`/`fallaReportada`/`tecnicoAsignado`/`costoEstimado`/
/// `fechaPrevistaFin` solo se esperan pobladas cuando `estadoNuevo` es
/// `EnMantenimiento`; `motivoBaja` cuando `estadoNuevo` es `DadoDeBaja` — el
/// backend no lo valida cruzado a propósito (ver openapi.yaml, descripción
/// de `PATCH /inventory/units/{id}/status`).
model ToolUnitStatusLog {
  id             String        @id @default(uuid()) @db.Uuid
  unidadId       String        @map("unidad_id") @db.Uuid
  estadoAnterior EstadoUnidad? @map("estado_anterior")
  estadoNuevo    EstadoUnidad  @map("estado_nuevo")
  fotosUrls      String[]      @default([]) @map("fotos_urls")
  /// FK lógica a `public.users.id` (Supabase Auth / AuthModule, Sprint 0).
  /// No se declara como relación de Prisma porque `users` no forma parte de
  /// este schema (fuera de alcance de Sprint 1 — ver comentario de cabecera).
  autorId   String   @map("autor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tipoMantenimiento TipoMantenimiento? @map("tipo_mantenimiento")
  fallaReportada    String?            @map("falla_reportada")
  tecnicoAsignado   String?            @map("tecnico_asignado")
  costoEstimado     Int?               @map("costo_estimado")
  fechaPrevistaFin  DateTime?          @map("fecha_prevista_fin") @db.Date
  motivoBaja        String?            @map("motivo_baja")

  unidad ToolUnit @relation(fields: [unidadId], references: [id])

  @@map("tool_unit_status_log")
  @@index([unidadId])
}

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  clienteId        String      @map("cliente_id") @db.Uuid
  tipo             TipoOrden
  estado           EstadoOrden @default(pendiente_pago)
  fechaInicio      DateTime?   @map("fecha_inicio") @db.Date
  fechaFin         DateTime?   @map("fecha_fin") @db.Date
  returnMode       ModoRetorno @map("return_mode")
  direccionEntrega String      @map("direccion_entrega")
  zonaId           String      @map("zona_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at")

  items    OrderItem[]
  payments Payment[]
  /// Sprint 4 — relación 1:1 ORDERS ||--|| SHIPMENTS (docs/DESIGN.md §4.1).
  shipment Shipment?

  @@map("orders")
  @@index([clienteId])
}

model OrderItem {
  id             String @id @default(uuid()) @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  unidadId       String @map("unidad_id") @db.Uuid
  tarifaAplicada Int    @map("tarifa_aplicada")

  order  Order    @relation(fields: [orderId], references: [id])
  unidad ToolUnit @relation(fields: [unidadId], references: [id])

  @@map("order_items")
  @@index([orderId])
  @@index([unidadId])
}

enum TipoPago {
  pago_alquiler
  pago_venta
  deposito_garantia
  cobro_mora

  @@map("tipo_pago")
}

enum MetodoPago {
  pse
  tarjeta
  contra_entrega

  @@map("metodo_pago")
}

enum EstadoPago {
  pendiente
  hold
  capturado
  reembolsado
  fallido

  @@map("estado_pago")
}

/// Pago asociado a una orden — RF-2.2/2.3/2.4 (Sprint 3). Ver
/// apps/api/src/modules/payments para el detalle de puertos/casos de uso.
model Payment {
  id                 String     @id @default(uuid()) @db.Uuid
  orderId            String     @map("order_id") @db.Uuid
  tipo               TipoPago
  metodo             MetodoPago
  estado             EstadoPago @default(pendiente)
  monto              Int
  wompiTransactionId String?    @map("wompi_transaction_id")
  createdAt          DateTime   @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
  @@index([orderId])
}

// ============================================================================
// Sprint 4 (Issues #11-#13, HU-4.1 a 4.3 — FleetModule/LogisticsModule):
// VEHICLES, SHIPMENTS, ROUTES (docs/DESIGN.md §4.1). `INSPECTION_CHECKLISTS`
// (recogida/devolución) llega en Sprint 5 (InspectionModule) — no se modela
// acá a propósito, mismo criterio que el resto de las migraciones por
// sprint.
// ============================================================================

enum TipoVehiculo {
  moto
  camioneta
  camion

  @@map("tipo_vehiculo")
}

enum TipoEnvio {
  entrega
  recogida

  @@map("tipo_envio")
}

enum EstadoEnvio {
  pendiente_asignacion
  en_ruta_entrega
  entregado
  en_ruta_recogida
  retornado

  @@map("estado_envio")
}

enum GeneradaPor {
  agente_1
  manual

  @@map("generada_por")
}

/// Vehículo de la flota — RF-3.1. `zonas` se modela como `String[]` (uuid
/// como texto, mismo criterio que `fotosUrls` en `ToolUnitStatusLog`) — ver
/// nota de `packages/shared-types/src/vehicle.ts` sobre por qué este campo
/// existe acá aunque el ER diagram de docs/DESIGN.md §4.1 no lo liste
/// (openapi.yaml, autoridad #1 de CLAUDE.md §1, sí lo declara).
model Vehicle {
  id          String       @id @default(uuid()) @db.Uuid
  tipo        TipoVehiculo
  capacidadKg Float        @map("capacidad_kg")
  capacidadM3 Float        @map("capacidad_m3")
  zonas       String[]     @default([])
  /// FK lógica a `public.users.id` (repartidor asignado al vehículo).
  /// No se declara como relación de Prisma porque `users` no forma parte de
  /// este schema (mismo criterio que `ToolUnitStatusLog.autorId`).
  repartidorId String?  @map("repartidor_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  /// Sprint 14 (HU-13.4). Nullable — vehículos creados antes de este campo
  /// no lo tienen; sin endpoint de escritura en este sprint (ver
  /// `packages/shared-types/src/vehicle.ts`, doc-comment de `Vehicle.placa`).
  placa String? @map("placa")

  shipments Shipment[]
  routes    Route[]

  @@map("vehicles")
}

/// Envío asociado a una orden — RF-3.1/3.3. Relación 1:1 con `orders`
/// (`orderId` único) — docs/DESIGN.md §4.1: `ORDERS ||--|| SHIPMENTS`. Se
/// crea automáticamente cuando la orden queda `confirmada` (ver
/// PaymentsModule/PagarOrdenUseCase) — sin endpoint propio de creación en
/// openapi.yaml.
model Shipment {
  id          String      @id @default(uuid()) @db.Uuid
  orderId     String      @unique @map("order_id") @db.Uuid
  vehiculoId  String?     @map("vehiculo_id") @db.Uuid
  tipo        TipoEnvio
  estadoEnvio EstadoEnvio @default(pendiente_asignacion) @map("estado_envio")
  createdAt   DateTime    @default(now()) @map("created_at")

  order    Order    @relation(fields: [orderId], references: [id])
  vehiculo Vehicle? @relation(fields: [vehiculoId], references: [id])
  inspecciones InspectionChecklist[]

  @@map("shipments")
  @@index([vehiculoId])
  @@index([estadoEnvio])
}

/// Ruta diaria de reparto/recogida — RF-3.1. `paradas` es un array de
/// `shipment_id` en orden de secuencia, modelado como `jsonb`
/// (docs/DESIGN.md §4.1), no como relación normalizada (decisión del Tech
/// Lead, Sprint 4).
model Route {
  id          String      @id @default(uuid()) @db.Uuid
  vehiculoId  String      @map("vehiculo_id") @db.Uuid
  fecha       DateTime    @db.Date
  paradas     Json        @default("[]")
  generadaPor GeneradaPor @default(manual) @map("generada_por")
  createdAt   DateTime    @default(now()) @map("created_at")

  vehiculo Vehicle @relation(fields: [vehiculoId], references: [id])

  @@map("routes")
  @@index([vehiculoId])
}

// ============================================================================
// Sprint 5 (Issues #14-#16, HU-5.1 a 5.3 — InspectionModule): tabla
// `inspection_checklists` (docs/DESIGN.md §4.1). `MoraCalculatorJob`
// (HU-5.3) no agrega tablas nuevas: reusa `payments` (`tipo: cobro_mora`,
// ya declarado en el enum `TipoPago` desde Sprint 3) — ver
// apps/workers/src/main.ts y
// apps/api/src/modules/inspections/application/ejecutar-mora-calculator.use-case.ts.
// ============================================================================

enum TipoInspeccion {
  salida
  recepcion

  @@map("tipo_inspeccion")
}

/// Checklist de inspección de salida/recepción de una unidad física —
/// RF-4.2. Tabla append-only (sin UPDATE/DELETE), mismo criterio que
/// `tool_unit_status_log` (docs/DESIGN.md §4.2).
model InspectionChecklist {
  id                String         @id @default(uuid()) @db.Uuid
  unidadId          String         @map("unidad_id") @db.Uuid
  shipmentId        String         @map("shipment_id") @db.Uuid
  tipo              TipoInspeccion
  /// Array de `{ descripcion: string, severidad: "leve"|"moderada"|"grave" }`
  /// — jsonb, no relación normalizada (mismo criterio que `Route.paradas`).
  hallazgos         Json           @default("[]")
  fotosUrls         String[]       @default([]) @map("fotos_urls")
  garantiaEjecutada Boolean        @default(false) @map("garantia_ejecutada")
  createdAt         DateTime       @default(now()) @map("created_at")

  unidad   ToolUnit @relation(fields: [unidadId], references: [id])
  shipment Shipment @relation(fields: [shipmentId], references: [id])

  @@map("inspection_checklists")
  @@index([unidadId])
  @@index([shipmentId])
}

// ============================================================================
// Sprint 6 (Issue #18, HU-6.2 — AuthOtpModule): OTPS, DEVICE_VERIFICATIONS.
// No hay modelo `User`/`USERS` en este schema (Supabase Auth es la fuente de
// verdad de usuarios, fuera de este Postgres gestionado por Prisma — mismo
// criterio que `Order.clienteId`, ver arriba): `usuarioId` es un uuid sin FK,
// igual que el resto de las referencias a usuarios en este schema.
// ============================================================================

/// OTP de verificación de dispositivo nuevo por WhatsApp — RF-6.2/HU-6.2.
/// `codigoHash` NUNCA almacena el código en texto plano (hasheado con
/// scrypt, ver infrastructure/hashing/otp-hasher.ts — mismo criterio que se
/// aplicaría a una contraseña). Tabla append-only en la práctica (solo se
/// actualiza `consumidoAt` al verificar, nunca se borra un OTP vencido —
/// queda como registro auditable, igual que `tool_unit_status_log`).
model Otp {
  id          String    @id @default(uuid()) @db.Uuid
  usuarioId   String    @map("usuario_id") @db.Uuid
  deviceId    String    @map("device_id")
  codigoHash  String    @map("codigo_hash")
  expiraEn    DateTime  @map("expira_en")
  consumidoAt DateTime? @map("consumido_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("otps")
  @@index([usuarioId, deviceId])
}

/// Registro de qué `device_id` ya superó la verificación OTP para qué
/// usuario — RF-6.2/HU-6.2. Consultado por el frontend (no por un guard
/// transversal del propio backend, decisión del Tech Lead: ver comentario en
/// `AuthOtpModule`) para decidir si bloquea la navegación hasta verificar.
model DeviceVerification {
  id         String   @id @default(uuid()) @db.Uuid
  usuarioId  String   @map("usuario_id") @db.Uuid
  deviceId   String   @map("device_id")
  verifiedAt DateTime @map("verified_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("device_verifications")
  @@unique([usuarioId, deviceId])
}

// ============================================================================
// Sprint 9 (Issues #26/#27, HU-10.1/10.2 — CartModule, Agente 3: Conserje de
// Voz). `carts`/`cart_items` NO están en docs/DESIGN.md §4.1 (ER diagram
// anterior a la Épica 10) — se agregan siguiendo el contrato de
// openapi.yaml `#/components/schemas/Cart`/`CartItem` (fuente de verdad #1,
// CLAUDE.md §1), mismo criterio de nombres/mapeo que el resto del schema.
// Un carrito por cliente (`clienteId` único) — ver
// apps/api/src/modules/cart/domain/cart.repository.ts para el detalle de
// diseño.
// ============================================================================

/// Carrito activo de un cliente — RF de Agente 3 (TRD §4.3). `clienteId` es
/// una FK lógica a `public.users.id` (Supabase Auth), sin relación de Prisma
/// declarada — mismo criterio que `Order.clienteId`.
model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  clienteId String   @unique @map("cliente_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items CartItem[]

  @@map("carts")
}

/// Línea de carrito — un modelo por línea (`@@unique([cartId, modeloId])`:
/// `POST /cart/add-item` SUMA cantidad en vez de duplicar la línea cuando el
/// modelo ya está en el carrito, ver AgregarItemCarritoUseCase).
model CartItem {
  id       String @id @default(uuid()) @db.Uuid
  cartId   String @map("cart_id") @db.Uuid
  modeloId String @map("modelo_id") @db.Uuid
  cantidad Int
  /// Días de alquiler solicitados para esta línea — `null` cuando la línea
  /// es de venta (ver cart-pricing.service.ts: se infiere alquiler/venta de
  /// la presencia de este campo, no hay un `tipo` explícito en `CartItem`,
  /// openapi.yaml).
  dias     Int?

  cart   Cart      @relation(fields: [cartId], references: [id])
  modelo ToolModel @relation(fields: [modeloId], references: [id])

  @@unique([cartId, modeloId])
  @@map("cart_items")
  @@index([cartId])
}

// ============================================================================
// Sprint 12 (Épica 12, HU-12.2 — ZonesModule): tabla `zones`, catálogo de
// zonas logísticas por ciudad para el selector dinámico de la ficha técnica
// del catálogo (GET /zones, endpoint público). No confundir con
// `Vehicle.zonas` (uuids sueltos en texto, asignación de rutas de
// FleetModule/LogisticsModule) ni con la clase `Zona` de
// `@toolboxjl/shared-types` (value object sin campo `ciudad`, usado en otro
// contexto) — este modelo es la fuente de verdad de qué zonas existen por
// ciudad para HU-12.2.
// ============================================================================

/// Zona logística de una ciudad — HU-12.2, Fase 3.
model Zone {
  id     String @id @default(uuid()) @db.Uuid
  nombre String
  ciudad String

  @@map("zones")
  @@index([ciudad])
}

// ============================================================================
// Sprint 14 (Épica 13, HU-13.4 — panel admin de Inventario QR, "Rutas del
// Día"): PRIMER caso de uso que necesita LEER `public.users` desde código
// Node (nombre de repartidor/cliente para GET /logistics/routes-today).
// Hasta acá `public.users` (creada por la migración
// 20260823235900_supabase_users_bootstrap, ver su comentario de cabecera)
// solo la leían las políticas RLS en SQL crudo — AuthModule verifica JWTs
// directo contra el JWKS de Supabase, nunca consulta `users` vía Prisma. Este
// modelo NO agrega una migración nueva (la tabla ya existe, creada por el
// bootstrap) — es un mirror de SOLO LECTURA: ninguna implementación de
// `UserRepository` (apps/api/src/modules/users) expone `crear`/`actualizar`,
// la única fuente de escritura sigue siendo el trigger `handle_new_user`.
// ============================================================================

enum RolUsuario {
  admin
  gerente
  almacenista
  repartidor
  cliente

  @@map("rol_usuario")
}

/// Mirror de solo lectura de `public.users` — ver comentario de la sección
/// de arriba. Columnas idénticas a las de la migración bootstrap.
model User {
  id       String     @id @db.Uuid
  email    String
  fullName String?    @map("full_name")
  telefono String?
  rol      RolUsuario @default(cliente)

  @@map("users")
}
