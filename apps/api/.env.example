# apps/api — variables de entorno
#
# AuthModule verifica los JWT emitidos por Supabase Auth contra el endpoint
# JWKS del proyecto (firma asimétrica ES256/RS256) — no se necesita ni se usa
# un JWT secret compartido. Ver apps/api/src/modules/auth/infrastructure/config/supabase-auth.config.ts.
#
# Sin SUPABASE_URL la app falla al arrancar con un error explícito (no hay
# fallback silencioso ni modo mock).

# URL del proyecto Supabase (Project Settings > API > Project URL).
# Ej.: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Audience esperado en el claim "aud" del JWT. Por defecto Supabase Auth
# emite "authenticated" para usuarios con sesión iniciada — normalmente no
# hace falta tocar esta variable.
SUPABASE_JWT_AUDIENCE=authenticated

# Puerto en el que escucha la API (Railway lo inyecta en runtime vía PORT;
# este valor es solo para desarrollo local).
PORT=3000

# CatalogModule/InventoryModule (Sprint 1) — cadena de conexión Postgres del
# proyecto Supabase, usada por Prisma (apps/api/prisma/schema.prisma). Sin
# DATABASE_URL, PrismaService falla al arrancar con un error explícito (no
# hay fallback silencioso ni modo mock) — ver
# src/modules/catalog-inventory/infrastructure/config/database.config.ts.
# Ej.: postgresql://postgres:<password>@db.xxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=

# PaymentsModule (Sprint 3) — credenciales de Wompi sandbox
# (https://sandbox.wompi.co/v1). Sin estas, WompiGatewayService (implementación
# real) falla al arrancar con un error explícito (no hay fallback silencioso
# ni modo mock) — ver
# src/modules/payments/infrastructure/config/wompi.config.ts.
# *** Este entorno de desarrollo no tiene credenciales de sandbox propias ***
# — es responsabilidad de quien tenga acceso al dashboard de Wompi
# generarlas. Para tests/BDD, se usa InMemoryWompiGateway, que no requiere
# estas variables.
WOMPI_PRIVATE_KEY=
WOMPI_PUBLIC_KEY=

# % del recargo logístico que se destina a la cuenta del proveedor logístico
# en el split simulado de pagos (RF-2.4). A diferencia de las credenciales de
# arriba, esta es una regla de negocio configurable, no un secreto: si no se
# define, WompiGatewayService usa 0.15 como default.
WOMPI_SPLIT_LOGISTICA_PCT=0.15

# PricingModule (Sprint 4, RF-3.2/HU-4.3) — recargo logístico por kg de peso
# de la herramienta, en COP enteros. Regla de negocio configurable, no un
# secreto: si no se define, PricingCalculatorService usa 500 como default
# (ver src/modules/pricing/infrastructure/config/pricing.config.ts). Se
# duplica automáticamente cuando la orden tiene
# return_mode=recogida_domicilio (dos viajes logísticos).
RECARGO_LOGISTICO_POR_KG_COP=500

# AuthOtpModule (Sprint 6, HU-6.2) — credenciales de WhatsApp Cloud API. Sin
# estas, WhatsAppOtpGatewayService (implementación real) falla al arrancar
# con un error explícito (no hay fallback silencioso ni modo mock) — ver
# src/modules/auth-otp/infrastructure/config/whatsapp.config.ts.
# A diferencia de Wompi, este entorno SÍ tiene credenciales reales cargadas
# como secrets de GitHub Actions (scope "Agents", ver CLAUDE.md §8) y se
# validan de verdad en CI — ver .github/workflows/whatsapp-otp-integration.yml.
# Para tests/BDD, se usa InMemoryWhatsAppOtpGateway, que no requiere estas
# variables.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Número de teléfono real (formato E.164, ej. +573001234567) al que el test
# de integración de CI puede enviarle un OTP real de punta a punta
# (WhatsAppOtpGatewayService.enviarOtp) para validar el envío, no solo las
# credenciales. OPCIONAL a propósito — nunca se inventó un número de prueba
# (instrucción explícita del Tech Lead): sin esta variable, ese test puntual
# queda en skip con un mensaje explícito en vez de fallar o simular éxito.
WHATSAPP_TEST_RECIPIENT_PHONE=

# Minutos de validez de un OTP antes de expirar (RF-6.2/HU-6.2). Regla de
# negocio configurable, no un secreto: si no se define, usa 10 como default.
OTP_EXPIRACION_MINUTOS=10

# Máximo de solicitudes de OTP por usuario/dispositivo dentro de la ventana
# de abajo (respalda el 429 de POST /auth/otp/request). Default: 3.
OTP_RATE_LIMIT_MAXIMO=3

# Ventana (en minutos) sobre la que se cuenta el límite de arriba. Default: 15.
OTP_RATE_LIMIT_VENTANA_MINUTOS=15
